{
  "name": "sureslot-server",
  "version": "2.0.0",
  "description": "Appointment Booking System API - MySQL Edition",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:prod": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:seed": "node src/config/seed.js",
    "db:reset": "npx prisma migrate reset --force",
    "db:push": "npx prisma db push",
    "setup": "npm install && npx prisma generate && npx prisma migrate dev --name init",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "appointment",
    "booking",
    "scheduling",
    "mysql",
    "prisma",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.0.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.8",
    "stripe": "^17.7.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.22.0"
  }
}
